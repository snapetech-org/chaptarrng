# syntax=docker/dockerfile:1.7

# This Dockerfile uses cross-compilation to build for multiple architectures
# efficiently without QEMU emulation overhead

###### node stage ######
# Use a pinned Node image instead of curl|bash installers.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0.404@sha256:fe0fd4e93bd2fbb47c883b7a6369e5c8d3db8bf01cdc5981f6ee35fbdf3ff4fb AS node
ARG BUILDARCH
RUN set -eux; \
    case "$BUILDARCH" in \
        amd64) node_arch=x64; node_sha=518674de2b621728a5e4486f5fb3b7d2900bb3cc4aa97969edaa463db99f9778; go_arch=amd64; go_sha=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840 ;; \
        arm64) node_arch=arm64; node_sha=80a330b35415382878df18d41afbd106ea89bfb3be0087d6608e289a14c5cc7d; go_arch=arm64; go_sha=3392582988a273a87ab5043ee1b2c9c17a2c3c00580bf9326c47a2e0aaaeac92 ;; \
        *) echo "Unsupported build architecture for Node.js or Go: $BUILDARCH" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --silent --show-error "https://nodejs.org/dist/v26.13.1/node-v26.13.1-linux-${node_arch}.tar.gz" -o /tmp/node.tar.gz; \
    echo "$node_sha  /tmp/node.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/node.tar.gz --strip-components=1 -C /usr/local; \
    rm /tmp/node.tar.gz; \
    curl --fail --location --silent --show-error "https://go.dev/dl/go1.27.4.linux-${go_arch}.tar.gz" -o /tmp/go.tar.gz; \
    echo "$go_sha  /tmp/go.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/go.tar.gz -C /usr/local; \
    rm /tmp/go.tar.gz; \
    export PATH="/usr/local/go/bin:$PATH"; \
    npm install -g npm@12.2.2 yarn@1.22.22 --force; \
    node --version; npm --version; yarn --version; go version
ENV PATH="/usr/local/go/bin:${PATH}"

###### browser stage ######
# Keep an arm/v7-compatible Node release for cross-platform Playwright assets.
FROM node AS browser
ARG TARGETARCH
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npm install -g npm@12.2.2 --force; \
    mkdir -p "$PLAYWRIGHT_BROWSERS_PATH"; \
    case "$TARGETARCH" in \
        amd64) PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-x64 npx --yes playwright@1.64.1 install --no-shell chromium ;; \
        arm64) PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=ubuntu24.04-arm64 npx --yes playwright@1.64.1 install --no-shell chromium ;; \
        arm) echo "Playwright Chromium is unavailable for linux/arm/v7; browser-assisted fallback will be unavailable on this image." ;; \
        *) echo "Unsupported architecture for Playwright Chromium: $TARGETARCH" && exit 1 ;; \
    esac

###### mp4v2 stage ######
FROM --platform=$TARGETPLATFORM alpine:3.24.4@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS mp4v2
RUN set -eux; \
    apk upgrade --no-cache; \
    apk add --no-cache libstdc++ libgcc; \
    apk add --no-cache --virtual .mp4v2-build-deps build-base autoconf automake libtool bzip2 curl; \
    curl --fail --location --silent --show-error https://github.com/enzo1982/mp4v2/releases/download/v2.1.3/mp4v2-2.1.3.tar.bz2 -o /tmp/mp4v2.tar.bz2; \
    echo '033185c17bf3c5fdd94020c95f8325be2e5356558e3913c3d6547a85dd61f7f1  /tmp/mp4v2.tar.bz2' | sha256sum -c -; \
    mkdir -p /tmp/mp4v2; \
    tar -xjf /tmp/mp4v2.tar.bz2 --strip-components=1 -C /tmp/mp4v2; \
    cd /tmp/mp4v2; \
    ./configure --prefix=/usr/local --disable-static --enable-shared; \
    make -j"$(nproc)"; \
    make install; \
    cd /; \
    rm -rf /tmp/mp4v2 /tmp/mp4v2.tar.bz2; \
    apk del .mp4v2-build-deps; \
    /usr/local/bin/mp4tags --version

###### deps stage ######
# Always build on the native architecture for speed
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0.404@sha256:fe0fd4e93bd2fbb47c883b7a6369e5c8d3db8bf01cdc5981f6ee35fbdf3ff4fb AS deps
WORKDIR /src

# Copy Node + Yarn from the official Node image (avoids curl|bash installers).
COPY --from=node /usr/local /usr/local
ENV PATH="/usr/local/go/bin:${PATH}"

# Copy only dependency manifests so cache is preserved when code changes
COPY package.json yarn.lock ./
# The pinned braces resolution is a local package and must exist before Yarn resolves it.
COPY patches/braces ./patches/braces
COPY patches/deepmerge ./patches/deepmerge

# Yarn 1 otherwise selects /usr/local/share/.cache/yarn in this copied toolchain.
# Keep its actual cache on the mount and serialize writers during parallel builds.
ENV YARN_CACHE_FOLDER=/root/.cache/yarn
RUN --mount=type=cache,target=/root/.cache/yarn,sharing=locked \
    yarn install --frozen-lockfile

###### build stage ######
FROM --platform=$BUILDPLATFORM deps AS build
WORKDIR /src

# Bring in the rest of the project *after* deps are installed
COPY . .

# Bundle the pinned signature verifier independently of the distribution gh version.
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*

# Front‑end build (architecture-independent)
RUN yarn typecheck
RUN yarn build

# Build for the target architecture only. When building multi-platform images with Buildx,
# Docker runs this Dockerfile once per target platform, so producing *all* arch outputs here
# just bloats every final image layer.
ARG TARGETPLATFORM
RUN --mount=type=cache,target=/root/.nuget/packages,sharing=locked \
    set -eu; \
    case "$TARGETPLATFORM" in \
        "linux/amd64") RUNTIME_ID="linux-x64" ;; \
        "linux/arm64") RUNTIME_ID="linux-arm64" ;; \
        "linux/arm/v7") RUNTIME_ID="linux-arm" ;; \
        *) echo "Unsupported platform: $TARGETPLATFORM" && exit 1 ;; \
    esac; \
    dotnet restore src/Chaptarr.NoTests.sln --locked-mode -m:1; \
    dotnet publish src/NzbDrone.Console/Chaptarr.Console.csproj -c Release -f net10.0 -r "$RUNTIME_ID" --self-contained false -o /app --no-restore /p:EnableWindowsTargeting=true /p:RunAnalyzersDuringBuild=false /p:RunCodeAnalysis=false /p:PublishSingleFile=false

RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    case "$TARGETPLATFORM" in       linux/amd64) verifier_rid=linux-x64 ;;       linux/arm64) verifier_rid=linux-arm64 ;;       linux/arm/v7) verifier_rid=linux-arm ;;       *) exit 1 ;;     esac && python3 packaging/scripts/install-update-verifier.py "$verifier_rid" /app/Tools

# Copy UI output to app directory
RUN mkdir -p /app/UI && cp -r _output/UI/* /app/UI/
RUN test -s /app/UI/index.html

###### runtime stage ######
# Pin the cross-platform runtime to the patch shipped with SDK 10.0.404.
FROM --platform=$TARGETPLATFORM mcr.microsoft.com/dotnet/aspnet:10.0.15-noble@sha256:bfd912c83295ce66d4b706ebb8541b9f14259b0e76fbb88b2751f58ce2399d2e AS chaptarrng-standard
RUN dotnet --list-runtimes | grep -Fq 'Microsoft.NETCore.App 10.0.15' \
    && dotnet --list-runtimes | grep -Fq 'Microsoft.AspNetCore.App 10.0.15'

# Copy Playwright Chromium from the browser stage
COPY --from=browser /ms-playwright /ms-playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Install runtime dependencies (these are architecture-specific)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bubblewrap \
        ffmpeg \
        php-cli php-mbstring php-xml php-json php-curl php-zip \
        wget \
        gosu \
        util-linux \
        iproute2 \
        postgresql-client \
        sqlite3 libsqlite3-0 \
        libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libdrm2 \
        libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
        libpango-1.0-0 libcairo2 libdbus-1-3 fonts-liberation libxshmfence1; \
    rm -rf /var/lib/apt/lists/*

# Copy pinned mp4v2 tools used by m4b-tool for chapter and tag writes. These
# binaries are musl-linked, so keep their runtime libraries private.
COPY --from=mp4v2 /usr/local/bin/mp4* /opt/mp4v2/bin/
COPY --from=mp4v2 /usr/local/lib/libmp4v2* /opt/mp4v2/lib/
COPY --from=mp4v2 /usr/lib/libstdc++.so.6* /usr/lib/libgcc_s.so.1 /opt/mp4v2/lib/
COPY --from=mp4v2 /lib/ld-musl-*.so.1 /lib/
COPY --from=mp4v2 /lib/ld-musl-*.so.1 /opt/mp4v2/lib/
COPY --from=mp4v2 /lib/libc.musl-*.so.1 /opt/mp4v2/lib/
RUN set -eux; \
    for tool in /opt/mp4v2/bin/mp4*; do \
        name="$(basename "$tool")"; \
        printf '%s\n' \
            '#!/bin/sh' \
            'export LD_LIBRARY_PATH="/opt/mp4v2/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"' \
            "exec /opt/mp4v2/bin/${name} \"\$@\"" \
            > "/usr/local/bin/${name}"; \
        chmod +x "/usr/local/bin/${name}"; \
    done; \
    mp4info --version; \
    mp4tags --version; \
    mp4chaps --version

# Download and install m4b-tool
ARG M4B_TOOL_URL=https://github.com/sandreas/m4b-tool/releases/download/v0.5.2/m4b-tool.phar
ARG M4B_TOOL_SHA256=a3ea9b81a4e8ce10ecc85c1fc712c982ba2622f2ed0318fb558dadfad4a590fa
RUN set -eux; \
    wget -O /usr/local/bin/m4b-tool "$M4B_TOOL_URL"; \
    echo "${M4B_TOOL_SHA256}  /usr/local/bin/m4b-tool" | sha256sum -c -; \
    chmod +x /usr/local/bin/m4b-tool; \
    php /usr/local/bin/m4b-tool --version

# Copy our robust entrypoint script
COPY docker-entrypoint.sh /entrypoint.sh
COPY docker-bookshelf-migration-detect.sh /docker-bookshelf-migration-detect.sh
COPY docker-bookshelf-compat-supervisor.sh /usr/local/bin/chaptarr-bookshelf-compat-supervisor
COPY docker-bookshelf-liveness.sh /usr/local/bin/chaptarr-bookshelf-liveness
COPY --chmod=0755 docker-startos-init.sh /init
RUN chmod +x /entrypoint.sh /usr/local/bin/chaptarr-bookshelf-compat-supervisor /usr/local/bin/chaptarr-bookshelf-liveness
COPY docker-healthcheck.sh /usr/local/bin/chaptarr-healthcheck
RUN chmod +x /usr/local/bin/chaptarr-healthcheck

WORKDIR /app

# Every fresh and migrated install uses this exact standard image.
EXPOSE 8787 8789

# Containers are updated by pulling a new image, not by the in-app updater.
ENV CHAPTARR_PACKAGE_UPDATE_MECHANISM=Docker \
    CHAPTARR_PACKAGE_UPDATE_MECHANISM_MESSAGE="Pull the new ChaptarrNG image to update."

COPY --from=build /app /app

# Set app permissions at build time
RUN chmod -R 755 /app

HEALTHCHECK --interval=30s --timeout=10s --start-period=2m --retries=3 \
    CMD ["/usr/local/bin/chaptarr-healthcheck"]
ENTRYPOINT ["/entrypoint.sh"]
CMD ["dotnet", "/app/Chaptarr.dll", "-nobrowser", "-data=/config"]

