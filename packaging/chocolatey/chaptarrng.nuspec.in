<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>chaptarrng</id>
    <version>__VERSION__</version>
    <title>ChaptarrNG</title>
    <authors>Snapetech</authors>
    <owners>Snapetech</owners>
    <projectUrl>https://github.com/snapetech/chaptarrng</projectUrl>
    <packageSourceUrl>https://github.com/snapetech/chaptarrng/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://github.com/snapetech/chaptarrng#readme</docsUrl>
    <bugTrackerUrl>https://github.com/snapetech/chaptarrng/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/snapetech/chaptarrng/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>ChaptarrNG is a standalone audiobook and ebook library manager. It runs locally and provides its own web interface.</description>
    <summary>Standalone audiobook and ebook library manager</summary>
    <tags>books audiobook ebook library chaptarrng</tags>
    <dependencies>
      <dependency id="nssm" version="2.24.101" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
