#!/bin/sh
set -eu

data_dir=/var/lib/bookshelfng
pending_marker="$data_dir/.chaptarrng-bookshelfng-migration-pending"
handoff_status="$data_dir/.chaptarrng-bookshelfng-handoff-status"
journal=/usr/lib/chaptarrng/handoff/bookshelfng-journal

# Native BookshelfNG packages preserve stopped/disabled service state. The
# marker is created only when a package manager replaces an installed legacy
# binary, so ordinary ChaptarrNG starts do not require a migration marker.
if [ ! -f "$pending_marker" ]; then
  exit 0
fi

write_status() {
  printf '%s\n' "$1" > "$handoff_status.tmp"
  chmod 0600 "$handoff_status.tmp"
  mv -f "$handoff_status.tmp" "$handoff_status"
  case "$1" in
    healthy|rolled-back)
      "$journal" state "$1"
      ;;
    operator-review-required|intervention-required)
      "$journal" state intervention-required
      ;;
  esac
}

if ! command -v systemctl >/dev/null 2>&1; then
  write_status operator-review-required
  echo 'systemd is unavailable; automatic migration readiness was not checked.' >&2
  exit 0
fi

fragment_path=$(systemctl show --property=FragmentPath --value bookshelfng.service 2>/dev/null || true)
dropin_paths=$(systemctl show --property=DropInPaths --value bookshelfng.service 2>/dev/null || true)
case "$fragment_path" in
  /lib/systemd/system/bookshelfng.service|/usr/lib/systemd/system/bookshelfng.service) ;;
  *)
    write_status operator-review-required
    echo 'BookshelfNG uses a custom or missing systemd unit; automatic migration readiness was not checked.' >&2
    exit 0
    ;;
esac
if [ -n "$dropin_paths" ]; then
  write_status operator-review-required
  echo 'BookshelfNG has systemd drop-ins; automatic migration readiness was not checked.' >&2
  exit 0
fi

health_timeout=${CHAPTARR_BOOKSHELF_HANDOFF_TIMEOUT_SECONDS:-14700}
case "$health_timeout" in
  ''|*[!0-9]*)
    write_status intervention-required
    echo 'CHAPTARR_BOOKSHELF_HANDOFF_TIMEOUT_SECONDS must be an integer from 1 to 14700.' >&2
    exit 1
    ;;
esac
while [ "${health_timeout#0}" != "$health_timeout" ] && [ "${#health_timeout}" -gt 1 ]; do
  health_timeout=${health_timeout#0}
done
if [ "${#health_timeout}" -gt 5 ] || [ "$health_timeout" -lt 1 ] || [ "$health_timeout" -gt 14700 ]; then
  write_status intervention-required
  echo 'CHAPTARR_BOOKSHELF_HANDOFF_TIMEOUT_SECONDS must be an integer from 1 to 14700.' >&2
  exit 1
fi
deadline=$(( $(date +%s) + health_timeout ))
health_url=${BOOKSHELFNG_HEALTH_URL:-auto}
while [ "$(date +%s)" -lt "$deadline" ]; do
  if /usr/lib/chaptarrng/bin/Chaptarr /check-bookshelf-migration -data="$data_dir" >/dev/null 2>&1; then
    remaining=$(( deadline - $(date +%s) ))
    if [ "$remaining" -lt 1 ]; then break; fi
    if ! /usr/lib/chaptarrng/bin/Chaptarr /check-bookshelf-migration \
      -data="$data_dir" \
      "-bookshelf-health-url=$health_url" \
      "-bookshelf-health-timeout-seconds=$remaining"; then
      write_status intervention-required
      echo "BookshelfNG conversion did not pass its database and local HTTP health checks within ${health_timeout} seconds. Automatic rollback will restore the retained source database and the prior BookshelfNG package if both are valid." >&2
      exit 1
    fi

    "$journal" outcome conversion verified
    "$journal" state converted
    "$journal" outcome promotion verified
    "$journal" state promoted
    "$journal" outcome health database-and-http-readable
    write_status healthy
    rm -f "$pending_marker"
    exit 0
  fi

  sleep 5
done

write_status intervention-required
echo "BookshelfNG conversion did not pass its database and local HTTP health checks within ${health_timeout} seconds. Automatic rollback will restore the retained source database and the prior BookshelfNG package if both are valid." >&2
exit 1
