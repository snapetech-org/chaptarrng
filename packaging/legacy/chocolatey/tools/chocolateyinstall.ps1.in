$ErrorActionPreference = 'Stop'

$installRoot = Join-Path $env:ProgramData 'BookshelfNG'
$appDir = Join-Path $installRoot 'app'
$stageDir = Join-Path $installRoot 'app.new'
$backupDir = Join-Path $installRoot 'app.previous'
$binDir = Join-Path $appDir 'bin'
$dataDir = Join-Path $installRoot 'data'
$exePath = Join-Path $binDir 'Chaptarr.Console.exe'
$archivePath = Join-Path $installRoot 'ChaptarrNG-__VERSION__-win-x64.zip'
$archiveUrl = 'https://github.com/snapetech/chaptarrng/releases/download/v__VERSION__/ChaptarrNG-__VERSION__-win-x64.zip'
$handoffDirectory = Join-Path $installRoot 'handoff'
$handoffManifestPath = Join-Path $handoffDirectory 'bookshelfng-migration-handoff.json'
$recoveryScriptPath = Join-Path $handoffDirectory 'bookshelfng-startup-recovery.ps1'
$recoveryTaskName = 'ChaptarrNG-BookshelfNG-Migration-Recovery'

$nssm = Get-Command nssm.exe -ErrorAction Stop
$packageParameters = ''
if ($env:ChocolateyPackageParameters) {
  $packageParameters = $env:ChocolateyPackageParameters.Trim().Trim('"').Trim("'")
}
$requestedProviderMode = $null
$requestedMigrationMode = 'automatic'
if (-not [string]::IsNullOrWhiteSpace($packageParameters)) {
  $seenParameters = @{}
  foreach ($parameter in ($packageParameters -split '\s+' | Where-Object { $_ })) {
    $parameterMatch = [regex]::Match($parameter, '(?i)^[/-](?<name>ProviderMode|MigrationMode)\s*[:=]\s*(?<value>[^\s]+)$')
    if (-not $parameterMatch.Success) {
      throw "Unsupported bookshelfng package parameter '$parameter'. Use /ProviderMode=Hardcover|Goodreads and /MigrationMode=automatic|ask|manual."
    }
    $name = $parameterMatch.Groups['name'].Value.ToLowerInvariant()
    if ($seenParameters.ContainsKey($name)) {
      throw "The bookshelfng package parameter $name was specified more than once."
    }
    $seenParameters[$name] = $parameterMatch.Groups['value'].Value
  }

  if ($seenParameters.ContainsKey('providermode')) {
    if ($seenParameters['providermode'] -notmatch '^(?i:Hardcover|Goodreads)$') {
      throw 'ProviderMode must be Hardcover or Goodreads.'
    }
    $requestedProviderMode = $seenParameters['providermode']
  }
  if ($seenParameters.ContainsKey('migrationmode')) {
    if ($seenParameters['migrationmode'] -notmatch '^(?i:automatic|ask|manual)$') {
      throw 'MigrationMode must be automatic, ask, or manual.'
    }
    $requestedMigrationMode = $seenParameters['migrationmode'].ToLowerInvariant()
  }
}

function Get-BookshelfServiceEnvironment {
  param([Parameter(Mandatory = $true)] [string] $Setting)
  $output = & $nssm.Source get BookshelfNG $Setting 2>$null
  if ($LASTEXITCODE -ne 0) { return @() }
  $text = $output | Out-String
  return @($text -split "`r?`n" | ForEach-Object { $_.Trim() } | Where-Object { $_ -match '^[^=]+=.*$' })
}

function Get-EnvironmentValue {
  param(
    [string[]] $Entries,
    [Parameter(Mandatory = $true)] [string] $Name
  )
  $value = $null
  foreach ($entry in $Entries) {
    $separator = $entry.IndexOf('=')
    if ($separator -gt 0 -and $entry.Substring(0, $separator).Equals($Name, [StringComparison]::OrdinalIgnoreCase)) {
      $value = $entry.Substring($separator + 1)
    }
  }
  return $value
}

function Get-ServiceDataDirectory {
  param(
    [string] $Parameters,
    [string] $BaseDirectory,
    [string] $Fallback
  )
  if ([string]::IsNullOrWhiteSpace($Parameters)) { return $Fallback }

  $pattern = '(?i)(?:^|\s)(?:-data|--data)(?:=|\s+)(?:"(?<double>[^"]*)"|''(?<single>[^'']*)''|(?<plain>\S+))'
  $matches = [regex]::Matches($Parameters, $pattern)
  if ($matches.Count -eq 0) { return $Fallback }

  $paths = @($matches | ForEach-Object {
    if ($_.Groups['double'].Success) { $_.Groups['double'].Value }
    elseif ($_.Groups['single'].Success) { $_.Groups['single'].Value }
    else { $_.Groups['plain'].Value }
  } | Select-Object -Unique)
  if ($paths.Count -ne 1 -or [string]::IsNullOrWhiteSpace($paths[0])) {
    throw 'The BookshelfNG service has conflicting or empty -data paths; the existing service was not changed.'
  }

  $path = [Environment]::ExpandEnvironmentVariables($paths[0])
  if ([IO.Path]::IsPathRooted($path)) { return [IO.Path]::GetFullPath($path) }
  $base = if ([string]::IsNullOrWhiteSpace($BaseDirectory)) { $installRoot } else { $BaseDirectory }
  return [IO.Path]::GetFullPath((Join-Path $base $path))
}

function Resolve-ProviderMode {
  param([string[]] $Entries)
  if ($requestedProviderMode) { return $requestedProviderMode }

  $hardcover = Get-EnvironmentValue $Entries 'HARDCOVER'
  $native = Get-EnvironmentValue $Entries 'HARDCOVER_NATIVE'
  if ($null -eq $hardcover) { $hardcover = [Environment]::GetEnvironmentVariable('HARDCOVER', 'Machine') }
  if ($null -eq $native) { $native = [Environment]::GetEnvironmentVariable('HARDCOVER_NATIVE', 'Machine') }
  if ($null -eq $hardcover) { $hardcover = $env:HARDCOVER }
  if ($null -eq $native) { $native = $env:HARDCOVER_NATIVE }

  if ($hardcover -eq 'true' -and $native -ne 'false') { return 'Hardcover' }
  return 'Goodreads'
}

function Get-EffectiveEnvironment {
  param([string[]] $Entries, [string] $ProviderMode)
  $result = @($Entries)
  if ($requestedProviderMode) {
    $result = @($result | Where-Object { $_ -notmatch '(?i)^HARDCOVER(?:_NATIVE)?=' })
    if ($ProviderMode -eq 'Hardcover') {
      $result += 'HARDCOVER=true', 'HARDCOVER_NATIVE=true'
    } else {
      $result += 'HARDCOVER=false', 'HARDCOVER_NATIVE=false'
    }
  }
  return $result
}

function Get-EffectiveExtraEnvironment {
  param([string[]] $Entries, [string] $ProviderMode)
  $result = @($Entries)
  if ($requestedProviderMode) {
    $result = @($result | Where-Object { $_ -notmatch '(?i)^HARDCOVER(?:_NATIVE)?=' })
    if ($ProviderMode -eq 'Hardcover') {
      $result += 'HARDCOVER=true', 'HARDCOVER_NATIVE=true'
    } else {
      $result += 'HARDCOVER=false', 'HARDCOVER_NATIVE=false'
    }
  }
  return $result
}

function Invoke-BookshelfUtility {
  param(
    [Parameter(Mandatory = $true)] [string] $Executable,
    [Parameter(Mandatory = $true)] [string[]] $Arguments,
    [string[]] $EnvironmentEntries = @()
  )
  $originalValues = @{}
  $originalNames = @{}
  try {
    foreach ($entry in $EnvironmentEntries) {
      $separator = $entry.IndexOf('=')
      if ($separator -le 0) { continue }
      $name = $entry.Substring(0, $separator)
      if (-not $originalNames.ContainsKey($name)) {
        $originalNames[$name] = $true
        $originalValues[$name] = [Environment]::GetEnvironmentVariable($name, 'Process')
      }
      [Environment]::SetEnvironmentVariable($name, $entry.Substring($separator + 1), 'Process')
    }

    & $Executable @Arguments
    return $LASTEXITCODE
  } finally {
    foreach ($name in $originalNames.Keys) {
      [Environment]::SetEnvironmentVariable($name, $originalValues[$name], 'Process')
    }
  }
}

function Set-BookshelfServiceSetting {
  param(
    [Parameter(Mandatory = $true)] [string] $Name,
    [Parameter(Mandatory = $true)] [AllowEmptyString()] [AllowNull()] [string] $Value
  )
  if ([string]::IsNullOrEmpty($Value)) {
    & $nssm.Source reset BookshelfNG $Name
  } else {
    & $nssm.Source set BookshelfNG $Name $Value
  }
  if ($LASTEXITCODE -ne 0) { throw "NSSM could not set BookshelfNG $Name." }
}

function Set-BookshelfServiceEnvironment {
  param(
    [Parameter(Mandatory = $true)] [string] $Setting,
    [string[]] $Entries
  )
  if ($Entries.Count -gt 0) {
    $arguments = @('set', 'BookshelfNG', $Setting) + $Entries
  } else {
    $arguments = @('reset', 'BookshelfNG', $Setting)
  }
  & $nssm.Source @arguments | Out-Null
  if ($LASTEXITCODE -ne 0) { throw 'NSSM could not update the BookshelfNG service environment.' }
}

function Test-BookshelfPostgresSource {
  param([string[]] $EnvironmentEntries)
  $configPath = Join-Path $dataDir 'config.xml'
  if (Test-Path -LiteralPath $configPath) {
    try {
      [xml] $config = Get-Content -LiteralPath $configPath -Raw
      $node = $config.SelectSingleNode("//*[local-name()='PostgresHost']")
      if ($node -and -not [string]::IsNullOrWhiteSpace($node.InnerText)) { return $true }
    } catch {
      throw "The BookshelfNG config could not be read to determine its database type: $($_.Exception.Message)"
    }
  }

  foreach ($entry in $EnvironmentEntries) {
    if ($entry -match '(?i)^(?:CHAPTARR|READARR|AUDIOARR)__POSTGRES__HOST=(.+)$' -and
        -not [string]::IsNullOrWhiteSpace($Matches[1])) {
      return $true
    }
  }
  foreach ($name in @('CHAPTARR__POSTGRES__HOST', 'READARR__POSTGRES__HOST', 'AUDIOARR__POSTGRES__HOST')) {
    if (-not [string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable($name, 'Machine')) -or
        -not [string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable($name, 'Process'))) {
      return $true
    }
  }
  return $false
}

function Wait-BookshelfServiceReady {
  param([string] $Url)
  $stopwatch = [Diagnostics.Stopwatch]::StartNew()
  while ($stopwatch.Elapsed.TotalSeconds -lt 90) {
    $current = Get-Service -Name 'BookshelfNG' -ErrorAction SilentlyContinue
    if (-not $current -or $current.Status -ne 'Running') {
      throw 'The ChaptarrNG process did not remain running under the BookshelfNG service identity.'
    }
    try {
      $response = Invoke-WebRequest -Uri $Url -UseBasicParsing -TimeoutSec 2 -MaximumRedirection 0
      if ($response.StatusCode -eq 200) { return }
    } catch { }
    if ($stopwatch.Elapsed.TotalSeconds -lt 90) { Start-Sleep -Seconds 2 }
  }
  throw "ChaptarrNG did not return HTTP 200 from $Url within 90 seconds."
}

function Write-BookshelfHandoffManifest {
  param([object] $Manifest)
  New-Item -ItemType Directory -Force -Path $handoffDirectory | Out-Null
  & icacls.exe $handoffDirectory /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)(F)' '*S-1-5-32-544:(OI)(CI)(F)' | Out-Null
  if ($LASTEXITCODE -ne 0) { throw 'Could not protect the Windows migration recovery directory.' }
  $temporaryPath = "$handoffManifestPath.tmp-$([Guid]::NewGuid().ToString('N'))"
  $Manifest | ConvertTo-Json -Depth 8 | Set-Content -LiteralPath $temporaryPath -Encoding UTF8
  Move-Item -LiteralPath $temporaryPath -Destination $handoffManifestPath -Force
  & icacls.exe $handoffManifestPath /inheritance:r /grant:r '*S-1-5-18:(F)' '*S-1-5-32-544:(F)' | Out-Null
  if ($LASTEXITCODE -ne 0) { throw 'Could not protect the Windows migration recovery record.' }
}

function Write-SharedMigrationJournal {
  param([string] $State, [string] $OutcomeName, [string] $OutcomeValue)

  try {
    $journalDirectory = Join-Path $dataDir '.chaptarrng-bookshelfng-journal'
    $statesDirectory = Join-Path $journalDirectory 'states'
    $outcomesDirectory = Join-Path $journalDirectory 'outcomes'
    New-Item -ItemType Directory -Force -Path $statesDirectory, $outcomesDirectory | Out-Null
    $utf8 = [Text.UTF8Encoding]::new($false)

    if (-not [string]::IsNullOrWhiteSpace($State)) {
      if ($State -notin @('detected', 'preflighted', 'snapshotted', 'converted', 'promoted', 'healthy', 'rolled-back', 'intervention-required')) {
        throw "Invalid shared BookshelfNG journal state '$State'."
      }

      $timestamp = [DateTime]::UtcNow.ToString('o')
      foreach ($targetPath in @((Join-Path $statesDirectory $State), (Join-Path $journalDirectory 'state'))) {
        $temporaryPath = "$targetPath.tmp-$([Guid]::NewGuid().ToString('N'))"
        [IO.File]::WriteAllText($temporaryPath, "$timestamp`n", $utf8)
        Move-Item -LiteralPath $temporaryPath -Destination $targetPath -Force
      }
    }

    if (-not [string]::IsNullOrWhiteSpace($OutcomeName)) {
      if ($OutcomeName -notmatch '^[A-Za-z0-9_.-]+$' -or $OutcomeValue -notmatch '^[A-Za-z0-9:._-]+$') {
        throw 'Invalid shared BookshelfNG journal outcome token.'
      }

      $targetPath = Join-Path $outcomesDirectory $OutcomeName
      $temporaryPath = "$targetPath.tmp-$([Guid]::NewGuid().ToString('N'))"
      [IO.File]::WriteAllText($temporaryPath, "$OutcomeValue`n", $utf8)
      Move-Item -LiteralPath $temporaryPath -Destination $targetPath -Force
    }
  } catch {
    Write-Warning "The Windows migration result could not be written to the shared journal: $($_.Exception.Message)"
  }
}

function Register-BookshelfRecoveryTask {
  if (-not (Test-Path -LiteralPath $recoveryScriptPath)) {
    throw "The Windows migration recovery script is missing at $recoveryScriptPath."
  }
  if (-not [Diagnostics.EventLog]::SourceExists('ChaptarrNG BookshelfNG Migration')) {
    New-EventLog -LogName Application -Source 'ChaptarrNG BookshelfNG Migration'
  }

  $xmlPath = Join-Path $handoffDirectory 'bookshelfng-migration-recovery-task.xml'
  $powershellPath = Join-Path $env:SystemRoot 'System32\WindowsPowerShell\v1.0\powershell.exe'
  $arguments = "-NoProfile -ExecutionPolicy Bypass -File `"$recoveryScriptPath`" -ManifestPath `"$handoffManifestPath`""
  $xmlArguments = [Security.SecurityElement]::Escape($arguments)
  $xmlPowerShell = [Security.SecurityElement]::Escape($powershellPath)
  $xml = @"
<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>Verifies and recovers a deferred BookshelfNG to ChaptarrNG service migration.</Description></RegistrationInfo>
  <Triggers>
    <EventTrigger><Enabled>true</Enabled><Subscription>&lt;QueryList&gt;&lt;Query Id="0" Path="System"&gt;&lt;Select Path="System"&gt;*[System[Provider[@Name='Service Control Manager'] and EventID=7036]] and *[EventData[Data[@Name='param1']='BookshelfNG' and Data[@Name='param2']='running']]&lt;/Select&gt;&lt;/Query&gt;&lt;/QueryList&gt;</Subscription><Delay>PT15S</Delay></EventTrigger>
  </Triggers>
  <Principals><Principal id="System"><UserId>S-1-5-18</UserId><RunLevel>HighestAvailable</RunLevel></Principal></Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy><DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries><AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable><Enabled>true</Enabled><Hidden>true</Hidden>
    <ExecutionTimeLimit>PT2H</ExecutionTimeLimit><Priority>4</Priority>
  </Settings>
  <Actions Context="System"><Exec><Command>$xmlPowerShell</Command><Arguments>$xmlArguments</Arguments></Exec></Actions>
</Task>
"@
  Set-Content -LiteralPath $xmlPath -Value $xml -Encoding Unicode
  & schtasks.exe /Create /TN $recoveryTaskName /XML $xmlPath /F | Out-Null
  if ($LASTEXITCODE -ne 0) { throw 'Windows could not register the migration recovery task.' }
}

function Remove-BookshelfRecoveryTask {
  & schtasks.exe /Delete /TN $recoveryTaskName /F 2>$null | Out-Null
}

function Complete-PriorBookshelfHandoff {
  if (-not (Test-Path -LiteralPath $handoffManifestPath)) { return }

  try {
    $previousHandoff = Get-Content -LiteralPath $handoffManifestPath -Raw | ConvertFrom-Json
  } catch {
    throw "The previous Windows BookshelfNG recovery record cannot be read safely. Preserve it at $handoffManifestPath."
  }

  if ($previousHandoff.State -eq 'pending') {
    $service = Get-Service -Name 'BookshelfNG' -ErrorAction SilentlyContinue
    if ($service -and $service.Status -eq 'Running' -and (Test-Path -LiteralPath $exePath)) {
      try {
        $currentApplication = (& $nssm.Source get BookshelfNG Application | Out-String).Trim().Trim('"')
        if ($LASTEXITCODE -ne 0 -or -not [string]::Equals(
              [IO.Path]::GetFullPath($currentApplication),
              [IO.Path]::GetFullPath($exePath),
              [StringComparison]::OrdinalIgnoreCase)) {
          throw 'The BookshelfNG service does not point to the expected ChaptarrNG executable.'
        }
        $response = Invoke-WebRequest -Uri $previousHandoff.HealthUrl -UseBasicParsing -TimeoutSec 3 -MaximumRedirection 0
        if ($response.StatusCode -eq 200) {
          $healthExit = Invoke-BookshelfUtility $exePath @('-check-bookshelf-migration', "-data=$($previousHandoff.DataDirectory)") @($previousHandoff.MigrationEnvironment)
          if ($healthExit -eq 0) {
            $previousHandoff.State = 'healthy'
            Write-BookshelfHandoffManifest $previousHandoff
            Write-SharedMigrationJournal -State 'healthy' -OutcomeName 'channel' -OutcomeValue 'chocolatey'
            Write-SharedMigrationJournal -OutcomeName 'channel-state' -OutcomeValue 'healthy'
          }
        }
      } catch {
        # Leave the pending handoff and its retained app in place for the scheduled recovery task.
      }
    }
  }

  if ($previousHandoff.State -eq 'healthy') {
    if (Test-Path -LiteralPath $backupDir) { Remove-Item -LiteralPath $backupDir -Recurse -Force -ErrorAction Stop }
    Remove-BookshelfRecoveryTask
    Remove-Item -LiteralPath $handoffManifestPath -Force -ErrorAction Stop
    return
  }

  if ($previousHandoff.State -eq 'rolled-back') {
    Remove-BookshelfRecoveryTask
    Remove-Item -LiteralPath $handoffManifestPath -Force -ErrorAction Stop
    return
  }

  throw "A previous deferred BookshelfNG migration is still $($previousHandoff.State). Start the BookshelfNG service and let its automatic health check finish before upgrading again. Recovery details are retained at $handoffManifestPath."
}

$service = Get-Service -Name 'BookshelfNG' -ErrorAction SilentlyContinue
$hadService = $null -ne $service
$wasRunning = $hadService -and $service.Status -ne 'Stopped'
$hadApp = Test-Path $appDir
$createdService = $false
$oldApplication = $null
$oldAppDirectory = $null
$oldAppParameters = $null
$oldAppEnvironment = @()
$oldAppEnvironmentExtra = @()
$serviceEnvironment = @()
$oldStart = $null
$backupNamesBefore = @()
$postgresBackupDirectory = $null
$migrationDatabaseMutationMayHaveStarted = $false
$deferredRecoveryArmed = $false
$alreadyMigrated = $false
$providerMode = $null
$effectiveEnvironment = @()
$healthPort = 8789
$healthUrlBase = ''

if ($hadService) {
  $healthPort = 8787
  $oldApplication = (& $nssm.Source get BookshelfNG Application | Out-String).Trim()
  if ($LASTEXITCODE -ne 0) { throw 'NSSM could not read the BookshelfNG application path.' }
  $oldAppDirectory = (& $nssm.Source get BookshelfNG AppDirectory | Out-String).Trim()
  if ($LASTEXITCODE -ne 0) { throw 'NSSM could not read the BookshelfNG working directory.' }
  $oldAppParameters = (& $nssm.Source get BookshelfNG AppParameters | Out-String).Trim()
  if ($LASTEXITCODE -ne 0) { throw 'NSSM could not read the BookshelfNG service parameters.' }
  $oldStart = (& $nssm.Source get BookshelfNG Start | Out-String).Trim()
  if ($LASTEXITCODE -ne 0) { throw 'NSSM could not read the BookshelfNG service start setting.' }
  $oldAppEnvironment = @(Get-BookshelfServiceEnvironment 'AppEnvironment')
  $oldAppEnvironmentExtra = @(Get-BookshelfServiceEnvironment 'AppEnvironmentExtra')
  $serviceEnvironment = @($oldAppEnvironment) + @($oldAppEnvironmentExtra)
  $providerMode = Resolve-ProviderMode $serviceEnvironment
  $effectiveEnvironment = Get-EffectiveEnvironment $serviceEnvironment $providerMode
  $dataDir = Get-ServiceDataDirectory $oldAppParameters $oldAppDirectory $dataDir
} else {
  $providerMode = Resolve-ProviderMode @()
  $effectiveEnvironment = Get-EffectiveEnvironment @() $providerMode
}

$dataDir = [IO.Path]::GetFullPath($dataDir)
$hadApp = Test-Path -LiteralPath $appDir
$sqliteSourceExisted = Test-Path -LiteralPath (Join-Path $dataDir 'readarr.db')
$postgresSourceForChoice = Test-BookshelfPostgresSource $serviceEnvironment
$alreadyMigratedForChoice = $false
$choiceConsolePath = if ($oldApplication) { $oldApplication.Trim().Trim('"') } else { '' }
if ($hadService -and (Test-Path -LiteralPath $choiceConsolePath) -and
    [IO.Path]::GetFileName($choiceConsolePath) -match '(?i)^Chaptarr(?:\.Console)?\.exe$') {
  $migrationStateExit = Invoke-BookshelfUtility $choiceConsolePath @(
    '-check-bookshelf-migration',
    "-data=$dataDir"
  ) $effectiveEnvironment
  $alreadyMigratedForChoice = $migrationStateExit -eq 0
}
$hasMigrationDataForChoice = $false
if (-not $alreadyMigratedForChoice) {
  $hasMigrationDataForChoice = $hadService -or $sqliteSourceExisted -or $postgresSourceForChoice
}

if ($hasMigrationDataForChoice -and $requestedMigrationMode -eq 'manual') {
  throw "MigrationMode=manual cancelled this package update before stopping BookshelfNG or changing its files. Use the ChaptarrNG Console migration commands in docs/MIGRATE_FROM_BOOKSHELFNG.md, then rerun the package update."
}

if ($hasMigrationDataForChoice -and $requestedMigrationMode -eq 'ask') {
  if ([Console]::IsInputRedirected) {
    throw 'MigrationMode=ask requires an interactive terminal. No files, service settings, or databases were changed; rerun with MigrationMode=automatic or MigrationMode=manual.'
  }

  $migrationChoice = Read-Host 'Replace BookshelfNG with ChaptarrNG now? A still-legacy database will be migrated automatically. [y/N]'
  if ($migrationChoice -notmatch '^(?i:y|yes)$') {
    throw 'BookshelfNG replacement cancelled before staging files or stopping the service. Run with MigrationMode=manual to review the independent migration steps.'
  }
}

Complete-PriorBookshelfHandoff
$backupNamesBefore = @(Get-ChildItem -LiteralPath $dataDir -Filter 'readarr.db.bookshelfng-backup-*.db' -File -ErrorAction SilentlyContinue | ForEach-Object Name)
$configPath = Join-Path $dataDir 'config.xml'
if (Test-Path -LiteralPath $configPath) {
  try {
    [xml] $config = Get-Content -LiteralPath $configPath -Raw
    $portNode = $config.SelectSingleNode("//*[local-name()='Port']")
    if ($portNode -and $portNode.InnerText -match '^\d+$') { $healthPort = [int] $portNode.InnerText }
    $urlBaseNode = $config.SelectSingleNode("//*[local-name()='UrlBase']")
    if ($urlBaseNode) { $healthUrlBase = $urlBaseNode.InnerText.Trim().Trim('/') }
  } catch {
    throw "The BookshelfNG config could not be read safely: $($_.Exception.Message)"
  }
}
foreach ($name in @('CHAPTARR__SERVER__PORT', 'READARR__SERVER__PORT', 'AUDIOARR__SERVER__PORT')) {
  $portValue = Get-EnvironmentValue $effectiveEnvironment $name
  if ($null -eq $portValue) { $portValue = [Environment]::GetEnvironmentVariable($name, 'Machine') }
  if ($null -eq $portValue) { $portValue = [Environment]::GetEnvironmentVariable($name, 'Process') }
  if ($portValue -match '^\d+$') { $healthPort = [int] $portValue; break }
}
foreach ($name in @('CHAPTARR__SERVER__URLBASE', 'READARR__SERVER__URLBASE', 'AUDIOARR__SERVER__URLBASE')) {
  $urlBaseValue = Get-EnvironmentValue $effectiveEnvironment $name
  if ($null -eq $urlBaseValue) { $urlBaseValue = [Environment]::GetEnvironmentVariable($name, 'Machine') }
  if ($null -eq $urlBaseValue) { $urlBaseValue = [Environment]::GetEnvironmentVariable($name, 'Process') }
  if ($null -ne $urlBaseValue) { $healthUrlBase = $urlBaseValue.Trim().Trim('/'); break }
}
if (-not [string]::IsNullOrWhiteSpace($oldAppParameters)) {
  $serverArgumentPattern = '(?i)(?:^|\s)[/-](?<name>port|urlbase)(?:=|\s+)(?:"(?<double>[^"]*)"|''(?<single>[^'']*)''|(?<plain>\S+))'
  foreach ($argument in [regex]::Matches($oldAppParameters, $serverArgumentPattern)) {
    $argumentValue = if ($argument.Groups['double'].Success) { $argument.Groups['double'].Value }
      elseif ($argument.Groups['single'].Success) { $argument.Groups['single'].Value }
      else { $argument.Groups['plain'].Value }
    if ($argument.Groups['name'].Value -ieq 'port' -and $argumentValue -match '^\d+$') {
      $healthPort = [int] $argumentValue
    } elseif ($argument.Groups['name'].Value -ieq 'urlbase') {
      $healthUrlBase = $argumentValue.Trim().Trim('/')
    }
  }
}
if ($healthPort -lt 1 -or $healthPort -gt 65535) { throw "The BookshelfNG configured port is invalid: $healthPort" }
$healthUrl = if ([string]::IsNullOrWhiteSpace($healthUrlBase)) {
  "http://127.0.0.1:$healthPort/ping"
} else {
  "http://127.0.0.1:$healthPort/$healthUrlBase/ping"
}

$hasMigrationData = $hadService -or $sqliteSourceExisted
$previewConsole = Join-Path $stageDir 'bin\Chaptarr.Console.exe'

if (Test-Path -LiteralPath $backupDir) {
  throw "A prior BookshelfNG package rollback directory exists at $backupDir. Restore or remove it before retrying."
}
if (Test-Path -LiteralPath $stageDir) {
  throw "A prior BookshelfNG package staging directory exists at $stageDir. Inspect it before retrying."
}

try {
  New-Item -ItemType Directory -Force -Path $installRoot, $dataDir, (Join-Path $stageDir 'bin') | Out-Null
  Get-ChocolateyWebFile -PackageName 'bookshelfng' -FileFullPath $archivePath `
    -Url $archiveUrl -Checksum '__ARCHIVE_SHA256__' -ChecksumType 'sha256'
  Expand-Archive -LiteralPath $archivePath -DestinationPath (Join-Path $stageDir 'bin') -Force
  if (-not (Test-Path (Join-Path $stageDir 'bin\Chaptarr.Console.exe')) -or
      -not (Test-Path (Join-Path $stageDir 'bin\UI\index.html'))) {
    throw 'The verified ChaptarrNG archive is missing its executable or web UI.'
  }
  @(
    'UpdateMethod=External',
    'UpdateMethodMessage=Use Chocolatey to update ChaptarrNG.',
    'Branch=main'
  ) | Set-Content -Encoding ascii -Path (Join-Path $stageDir 'package_info')
} catch {
  if (Test-Path -LiteralPath $stageDir) { Remove-Item -LiteralPath $stageDir -Recurse -Force -ErrorAction SilentlyContinue }
  if (Test-Path -LiteralPath $archivePath) { Remove-Item -LiteralPath $archivePath -Force -ErrorAction SilentlyContinue }
  throw
}

try {
  $postgresSource = Test-BookshelfPostgresSource $serviceEnvironment
  $hasMigrationData = $hasMigrationData -or $postgresSource
  if ($hadService -and $wasRunning) {
    Stop-Service -Name 'BookshelfNG' -Force
    $service.WaitForStatus('Stopped', [TimeSpan]::FromSeconds(30))
  }

  if ($hasMigrationData) {
    $targetDatabaseExit = Invoke-BookshelfUtility $previewConsole @(
      '-check-bookshelf-migration',
      "-data=$dataDir"
    ) $effectiveEnvironment
    $alreadyMigrated = $targetDatabaseExit -eq 0
  }

  if ($hasMigrationData -and $postgresSource -and -not $alreadyMigrated) {
    $checkExit = Invoke-BookshelfUtility $previewConsole @(
      '-check-bookshelf-postgres-backup',
      '-confirm-bookshelf-service-stopped',
      "-data=$dataDir"
    ) $effectiveEnvironment
    if ($checkExit -ne 0) {
      throw "PostgreSQL backup preflight failed with exit code $checkExit. Ensure pg_dump and pg_restore are installed and stop every other client of these databases."
    }

    $postgresBackupDirectory = Join-Path $dataDir ("bookshelfng-postgres-backup-{0}" -f [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssfffZ'))
    if (Test-Path -LiteralPath $postgresBackupDirectory) {
      throw "A PostgreSQL backup path already exists at $postgresBackupDirectory; inspect it before retrying."
    }
    New-Item -ItemType Directory -Path $postgresBackupDirectory | Out-Null
    $backupExit = Invoke-BookshelfUtility $previewConsole @(
      '-backup-bookshelf-postgres',
      '-confirm-bookshelf-service-stopped',
      "-bookshelf-postgres-backup=$postgresBackupDirectory",
      "-data=$dataDir"
    ) $effectiveEnvironment
    if ($backupExit -ne 0) {
      throw "Independent PostgreSQL backup failed with exit code $backupExit. The BookshelfNG database was not migrated."
    }
  }

  if ($hasMigrationData -and -not $alreadyMigrated) {
    $previewExit = Invoke-BookshelfUtility $previewConsole @(
      '-preview-bookshelf-migration',
      "-data=$dataDir"
    ) $effectiveEnvironment
    if ($previewExit -ne 0) {
      if (-not $providerMode) {
        throw "BookshelfNG migration preview failed with exit code $previewExit. If the source uses bare numeric provider IDs, rerun with the Chocolatey package parameter /ProviderMode=Goodreads or /ProviderMode=Hardcover. The original service and database were preserved."
      }
      throw "BookshelfNG migration preview failed with exit code $previewExit. The original service and database were preserved."
    }
  }

  if ($hadService -and $hasMigrationData -and -not $wasRunning) {
    New-Item -ItemType Directory -Force -Path $handoffDirectory | Out-Null
    & icacls.exe $handoffDirectory /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)(F)' '*S-1-5-32-544:(OI)(CI)(F)' | Out-Null
    if ($LASTEXITCODE -ne 0) { throw 'Could not protect the Windows migration recovery directory.' }
    Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'bookshelfng-startup-recovery.ps1') -Destination $recoveryScriptPath -Force
    $manifest = [ordered]@{
      State = 'pending'
      LastError = ''
      NewApplication = $exePath
      ConsolePath = $exePath
      ApplicationDirectory = $appDir
      PreviousApplicationDirectory = $backupDir
      DataDirectory = $dataDir
      HealthPort = $healthPort
      HealthUrl = $healthUrl
      NssmPath = $nssm.Source
      HadApplication = $hadApp
      WasRunning = $wasRunning
      OldApplication = $oldApplication
      OldAppDirectory = $oldAppDirectory
      OldAppParameters = $oldAppParameters
      OldAppEnvironment = @($oldAppEnvironment)
      OldAppEnvironmentExtra = @($oldAppEnvironmentExtra)
      MigrationEnvironment = @($effectiveEnvironment)
      OldStart = $oldStart
      SqliteSourceExisted = $sqliteSourceExisted
      SqliteBackupNamesBefore = @($backupNamesBefore)
      PostgresSource = $postgresSource
      PostgresBackupDirectory = $postgresBackupDirectory
      BookshelfSource = -not $alreadyMigrated
    }
    Write-BookshelfHandoffManifest $manifest
    $deferredRecoveryArmed = $true
    Register-BookshelfRecoveryTask
  }

  if ($hadApp) { Move-Item -LiteralPath $appDir -Destination $backupDir }
  Move-Item -LiteralPath $stageDir -Destination $appDir

  if (-not $hadService) {
    & $nssm.Source install BookshelfNG $exePath
    if ($LASTEXITCODE -ne 0) { throw 'NSSM could not install the ChaptarrNG service under the existing BookshelfNG name.' }
    $createdService = $true
    Set-BookshelfServiceSetting 'AppDirectory' $binDir
    Set-BookshelfServiceSetting 'AppParameters' "/nobrowser -data=$dataDir"
    Set-BookshelfServiceSetting 'Start' 'SERVICE_AUTO_START'
  } else {
    Set-BookshelfServiceSetting 'Application' $exePath
    Set-BookshelfServiceSetting 'AppDirectory' $binDir
    if ([string]::IsNullOrWhiteSpace($oldAppParameters)) {
      Set-BookshelfServiceSetting 'AppParameters' "/nobrowser -data=$dataDir"
    } else {
      Set-BookshelfServiceSetting 'AppParameters' $oldAppParameters
    }
  }

  if ($requestedProviderMode) {
    $effectiveEnvironment = Get-EffectiveEnvironment $serviceEnvironment $providerMode
    $serviceAppEnvironment = @($oldAppEnvironment | Where-Object { $_ -notmatch '(?i)^HARDCOVER(?:_NATIVE)?=' })
    $serviceExtraEnvironment = Get-EffectiveExtraEnvironment $oldAppEnvironmentExtra $providerMode
    Set-BookshelfServiceEnvironment 'AppEnvironment' $serviceAppEnvironment
    Set-BookshelfServiceEnvironment 'AppEnvironmentExtra' $serviceExtraEnvironment
  }

  if (-not $hadService -or $wasRunning) {
    $migrationDatabaseMutationMayHaveStarted = $true
    if ($hadService) { Start-Service -Name 'BookshelfNG' }
    else {
      & $nssm.Source start BookshelfNG
      if ($LASTEXITCODE -ne 0) { throw 'NSSM could not start ChaptarrNG.' }
    }
    $service = Get-Service -Name 'BookshelfNG' -ErrorAction Stop
    $service.WaitForStatus('Running', [TimeSpan]::FromSeconds(60))
    Wait-BookshelfServiceReady $healthUrl
    if ($hasMigrationData) {
      $readinessConsole = Join-Path $appDir 'bin\Chaptarr.Console.exe'
      $readinessExit = Invoke-BookshelfUtility $readinessConsole @(
        '-check-bookshelf-migration',
        "-data=$dataDir"
      ) $effectiveEnvironment
      if ($readinessExit -ne 0) {
        throw "ChaptarrNG started, but the migrated BookshelfNG database and provider profile were not readable (exit code $readinessExit)."
      }
      Write-SharedMigrationJournal -State 'healthy' -OutcomeName 'channel' -OutcomeValue 'chocolatey'
      Write-SharedMigrationJournal -OutcomeName 'channel-state' -OutcomeValue 'healthy'
    }
  }

  if ($deferredRecoveryArmed) {
    Write-Warning "BookshelfNG was stopped before this update. Its previous application is retained at $backupDir until the first ChaptarrNG startup passes the database and provider-profile health check."
  } elseif (Test-Path $backupDir) {
    try { Remove-Item -LiteralPath $backupDir -Recurse -Force -ErrorAction Stop }
    catch { Write-Warning "ChaptarrNG is installed, but the previous app files remain at $backupDir." }
  }
} catch {
  $installFailure = $_
  if ($deferredRecoveryArmed -and (Test-Path -LiteralPath $handoffManifestPath)) {
    try {
      $manifest = Get-Content -LiteralPath $handoffManifestPath -Raw | ConvertFrom-Json
      $manifest.State = 'rolled-back'
      $manifest.LastError = 'Chocolatey package installation rolled back before the deferred service start.'
      Write-BookshelfHandoffManifest $manifest
      Write-SharedMigrationJournal -State 'rolled-back' -OutcomeName 'channel' -OutcomeValue 'chocolatey'
      Write-SharedMigrationJournal -OutcomeName 'channel-state' -OutcomeValue 'rolled-back'
      Remove-BookshelfRecoveryTask
    } catch {
      Write-Warning "The deferred recovery marker could not be retired; preserve $handoffManifestPath for review. $($_.Exception.Message)"
    }
  }
  $databaseRollbackSafe = $true
  $applicationRollbackSafe = $true
  $serviceRollbackSafe = $true
  $currentService = Get-Service -Name 'BookshelfNG' -ErrorAction SilentlyContinue
  $serviceStopped = -not $currentService -or $currentService.Status -eq 'Stopped'
  if (-not $serviceStopped) {
    try {
      Stop-Service -Name 'BookshelfNG' -Force
      $currentService.WaitForStatus('Stopped', [TimeSpan]::FromSeconds(30))
      $serviceStopped = $true
    } catch {
      $serviceStopped = $false
      Write-Warning "Could not stop the failed BookshelfNG service; database and application rollback will be retained without restarting either version. $($_.Exception.Message)"
    }
  }

  if ($alreadyMigrated -and $migrationDatabaseMutationMayHaveStarted) {
    # The previous package may have applied ChaptarrNG schema changes before
    # failing. A BookshelfNG backup cannot safely roll this target database
    # back, so retain it and leave the restored prior app stopped for review.
    $databaseRollbackSafe = $false
    Write-Warning 'The install failed after a ChaptarrNG database was detected. The target database was preserved; the prior application was restored and the service will remain stopped until database compatibility is reviewed.'
  } elseif ($migrationDatabaseMutationMayHaveStarted) {
    if (-not $serviceStopped) {
      $databaseRollbackSafe = $false
    } elseif ($postgresSource) {
      $rollbackConsole = Join-Path $appDir 'bin\Chaptarr.Console.exe'
      if (-not (Test-Path -LiteralPath $rollbackConsole)) { $rollbackConsole = $previewConsole }
      if ($postgresBackupDirectory -and (Test-Path -LiteralPath $postgresBackupDirectory) -and
          (Test-Path -LiteralPath $rollbackConsole)) {
        try {
          $restoreExit = Invoke-BookshelfUtility $rollbackConsole @(
            '-restore-bookshelf-postgres',
            '-confirm-bookshelf-service-stopped',
            "-bookshelf-postgres-backup=$postgresBackupDirectory",
            "-data=$dataDir"
          ) $effectiveEnvironment
          if ($restoreExit -ne 0) { throw "PostgreSQL restore exited with code $restoreExit." }
        } catch {
          $databaseRollbackSafe = $false
          Write-Warning "Could not restore the PostgreSQL migration backup. Keep the BookshelfNG service stopped. The independent backup remains at $postgresBackupDirectory. $($_.Exception.Message)"
        }
      } else {
        $databaseRollbackSafe = $false
        Write-Warning "PostgreSQL migration may have started, but its independent restore backup or utility is unavailable. Keep the BookshelfNG service stopped; inspect the retained database backup at $postgresBackupDirectory."
      }
    } elseif ($sqliteSourceExisted) {
      $newDatabaseBackup = Get-ChildItem -LiteralPath $dataDir -Filter 'readarr.db.bookshelfng-backup-*.db' -File -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -notin $backupNamesBefore } |
        Sort-Object LastWriteTimeUtc -Descending |
        Select-Object -First 1
      if ($newDatabaseBackup) {
        try {
          $databasePath = Join-Path $dataDir 'readarr.db'
          $failedPath = "$databasePath.chaptarr-failed-$([DateTime]::UtcNow.ToString('yyyyMMddTHHmmssfffZ'))"
          if (Test-Path -LiteralPath $databasePath) { Move-Item -LiteralPath $databasePath -Destination $failedPath }
          foreach ($suffix in @('-wal', '-shm', '-journal')) {
            $sidecar = "$databasePath$suffix"
            if (Test-Path -LiteralPath $sidecar) { Move-Item -LiteralPath $sidecar -Destination "$failedPath$suffix" }
          }
          Copy-Item -LiteralPath $newDatabaseBackup.FullName -Destination $databasePath
        } catch {
          $databaseRollbackSafe = $false
          Write-Warning "Could not restore the SQLite BookshelfNG database. Keep the BookshelfNG service stopped; the source backup remains at $($newDatabaseBackup.FullName). $($_.Exception.Message)"
        }
      } else {
        $databaseRollbackSafe = $false
        Write-Warning 'Migration may have started, but no new SQLite source backup was found. Keep the BookshelfNG service stopped and inspect the retained database before recovery.'
      }
    } else {
      try {
        $databasePath = Join-Path $dataDir 'readarr.db'
        $failedPath = "$databasePath.chaptarr-failed-$([DateTime]::UtcNow.ToString('yyyyMMddTHHmmssfffZ'))"
        if (Test-Path -LiteralPath $databasePath) { Move-Item -LiteralPath $databasePath -Destination $failedPath -ErrorAction Stop }
        foreach ($suffix in @('-wal', '-shm', '-journal')) {
          $sidecar = "$databasePath$suffix"
          if (Test-Path -LiteralPath $sidecar) { Move-Item -LiteralPath $sidecar -Destination "$failedPath$suffix" -ErrorAction Stop }
        }
      } catch {
        $databaseRollbackSafe = $false
        Write-Warning "Could not move the newly created SQLite database out of the install path. Keep BookshelfNG stopped and preserve the failed database for recovery. $($_.Exception.Message)"
      }
    }
  }

  if (-not $serviceStopped) {
    $applicationRollbackSafe = $false
    $serviceRollbackSafe = $false
    Write-Warning "The BookshelfNG process is still active. Leaving its files, service registration, and retained backups in place for manual recovery."
  } else {
    if ($createdService) {
      try {
        & $nssm.Source remove BookshelfNG confirm | Out-Null
        if ($LASTEXITCODE -ne 0) { throw "NSSM remove exited with code $LASTEXITCODE." }
      } catch {
        $applicationRollbackSafe = $false
        Write-Warning "Could not remove the newly created BookshelfNG service during rollback. $($_.Exception.Message)"
      }
    }
    try {
      if ((Test-Path -LiteralPath $backupDir) -or -not $hadApp) {
        if (Test-Path -LiteralPath $appDir) { Remove-Item -LiteralPath $appDir -Recurse -Force -ErrorAction Stop }
      }
      if (Test-Path -LiteralPath $backupDir) { Move-Item -LiteralPath $backupDir -Destination $appDir -ErrorAction Stop }
      elseif ($hadApp -and -not (Test-Path -LiteralPath $appDir)) {
        throw "The previous application files are unavailable at $backupDir."
      }
    } catch {
      $applicationRollbackSafe = $false
      Write-Warning "Could not restore the previous BookshelfNG application files. Preserve $backupDir for manual recovery. $($_.Exception.Message)"
    }

    if ($hadService) {
      try {
        Set-BookshelfServiceSetting 'Application' $oldApplication
        Set-BookshelfServiceSetting 'AppDirectory' $oldAppDirectory
        Set-BookshelfServiceSetting 'AppParameters' $oldAppParameters
        Set-BookshelfServiceEnvironment 'AppEnvironment' $oldAppEnvironment
        Set-BookshelfServiceEnvironment 'AppEnvironmentExtra' $oldAppEnvironmentExtra
        Set-BookshelfServiceSetting 'Start' $oldStart
      } catch {
        $serviceRollbackSafe = $false
        Write-Warning "Could not fully restore the previous BookshelfNG service configuration. Leave it stopped for manual recovery. $($_.Exception.Message)"
      }
    }
  }
  if ($wasRunning -and $serviceStopped -and $databaseRollbackSafe -and
      $applicationRollbackSafe -and $serviceRollbackSafe) {
    Write-SharedMigrationJournal -State 'rolled-back' -OutcomeName 'channel' -OutcomeValue 'chocolatey'
    Write-SharedMigrationJournal -OutcomeName 'channel-state' -OutcomeValue 'rolled-back'
    try { Start-Service -Name 'BookshelfNG' }
    catch {
      Write-SharedMigrationJournal -State 'intervention-required' -OutcomeName 'channel' -OutcomeValue 'chocolatey'
      Write-SharedMigrationJournal -OutcomeName 'channel-state' -OutcomeValue 'intervention-required'
      Write-Warning "The previous BookshelfNG service and data were restored, but the service could not be restarted. $($_.Exception.Message)"
    }
  } elseif ($wasRunning) {
    Write-SharedMigrationJournal -State 'intervention-required' -OutcomeName 'channel' -OutcomeValue 'chocolatey'
    Write-SharedMigrationJournal -OutcomeName 'channel-state' -OutcomeValue 'intervention-required'
    Write-Warning 'Automatic rollback left BookshelfNG stopped because the restored app or source database could not be verified.'
  } elseif (-not $databaseRollbackSafe -or -not $applicationRollbackSafe -or -not $serviceRollbackSafe) {
    Write-SharedMigrationJournal -State 'intervention-required' -OutcomeName 'channel' -OutcomeValue 'chocolatey'
    Write-SharedMigrationJournal -OutcomeName 'channel-state' -OutcomeValue 'intervention-required'
  } elseif ($migrationDatabaseMutationMayHaveStarted) {
    Write-SharedMigrationJournal -State 'rolled-back' -OutcomeName 'channel' -OutcomeValue 'chocolatey'
    Write-SharedMigrationJournal -OutcomeName 'channel-state' -OutcomeValue 'rolled-back'
  }
  throw $installFailure
} finally {
  if (Test-Path $stageDir) { Remove-Item -LiteralPath $stageDir -Recurse -Force -ErrorAction SilentlyContinue }
  if (Test-Path $archivePath) { Remove-Item -LiteralPath $archivePath -Force -ErrorAction SilentlyContinue }
}

Write-Host 'The bookshelfng package now runs the standard ChaptarrNG release. Its service identity and data directory were preserved.'
