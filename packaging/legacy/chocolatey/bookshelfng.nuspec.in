<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>bookshelfng</id>
    <version>__VERSION__</version>
    <title>ChaptarrNG migration update for BookshelfNG installs</title>
    <authors>Snapetech</authors>
    <owners>Snapetech</owners>
    <copyright>Copyright © 2026 Snapetech and SeerrNG contributors for ChaptarrNG fork-specific changes; copyright © 2026 Chaptarr contributors for inherited Chaptarr changes; portions copyright © 2010–2026 the Servarr team and contributors.</copyright>
    <projectUrl>https://github.com/snapetech-org/chaptarrng</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/snapetech-org/chaptarrng@1171a870bf1f44dac799eae53f44507562ed78f8/frontend/src/Content/Images/Icons/apple-touch-icon.png</iconUrl>
    <packageSourceUrl>https://github.com/snapetech-org/chaptarrng/tree/main/packaging/legacy/chocolatey</packageSourceUrl>
    <projectSourceUrl>https://github.com/snapetech-org/chaptarrng</projectSourceUrl>
    <mailingListUrl>https://github.com/snapetech-org/chaptarrng/discussions</mailingListUrl>
    <releaseNotes>https://github.com/snapetech-org/chaptarrng/releases</releaseNotes>
    <docsUrl>https://github.com/snapetech-org/chaptarrng/blob/main/docs/MIGRATE_FROM_BOOKSHELFNG.md</docsUrl>
    <bugTrackerUrl>https://github.com/snapetech-org/chaptarrng/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/snapetech-org/chaptarrng/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Updates an installed BookshelfNG Chocolatey package to the standard ChaptarrNG application. It keeps the bookshelfng package ID, Windows service name, and data directory while ChaptarrNG converts supported BookshelfNG SQLite data on startup and retains a source backup.</description>
    <summary>Migration update for existing BookshelfNG Chocolatey installs</summary>
    <tags>books audiobook ebook library bookshelfng chaptarrng migration</tags>
    <dependencies>
      <dependency id="nssm" version="2.24.101" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
