DOMAIN=bookshelfng.example.com
EXTRA_DOMAINS=
LETS_ENCRYPT_ENV=production
BOOKSHELFNG_PORT=8787
BOOKSHELFNG_HOST_PORT=8787
CHAPTARRNG_COMPAT_IMAGE=ghcr.io/snapetech-org/chaptarrng:bookshelf-hardcover
# The previous Co-op Cloud recipe used the Hardcover image. Set false only
# when migrating a prior softcover image.
HARDCOVER=true
# Keep true unless the old service explicitly set HARDCOVER_NATIVE=false.
HARDCOVER_NATIVE=true
# Use retry only after a clean rollback and after correcting its cause.
BOOKSHELFNG_MIGRATION_MODE=automatic
