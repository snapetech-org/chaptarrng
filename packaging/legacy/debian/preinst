#!/bin/sh
set -e
run_dir="${DPKG_ROOT:-}/run"
root="${DPKG_ROOT:-}"
source_binary="$root/usr/lib/bookshelfng/Readarr"
target_package_info="$root/usr/lib/chaptarrng/package_info"
data_dir="$root/var/lib/bookshelfng"
pending_marker="$data_dir/.chaptarrng-bookshelfng-migration-pending"

if [ "$1" = install ] || [ "$1" = upgrade ]; then
  if [ ! -e "$target_package_info" ] && [ -x "$source_binary" ]; then
    mkdir -p "$data_dir"
    touch "$pending_marker"
    chmod 0600 "$pending_marker"
  fi

  if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet bookshelfng.service; then
    mkdir -p "$run_dir"
    touch "$run_dir/bookshelfng-package-was-active"
    systemctl stop bookshelfng.service
  fi
fi

exit 0
