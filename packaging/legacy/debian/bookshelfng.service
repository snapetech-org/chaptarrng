[Unit]
Description=ChaptarrNG (BookshelfNG package identity)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bookshelfng
Group=bookshelfng
WorkingDirectory=/var/lib/bookshelfng
EnvironmentFile=-/etc/bookshelfng/bookshelfng.env
ExecStart=/usr/lib/chaptarrng/bin/Chaptarr /nobrowser -data=/var/lib/bookshelfng
ExecStartPost=/usr/lib/chaptarrng/handoff/bookshelfng-healthcheck
Restart=on-failure
RestartSec=5s
TimeoutStartSec=900s
KillSignal=SIGINT
TimeoutStopSec=90s
UMask=0027
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
